//@version=5
indicator("Merged Algo", overlay = true, max_labels_count = 500)

// =====================================================================
//  MERGED ALGO
//  Signals + risk levels : Diamond Algo (supertrend + SMA13, EMA200 "smart" tag, ADX filter)
//  Volatility levels     : Binocular (settlement +/- 0.5 / 0.7 / 1.0 SD from daily HV)
//  Dashboard             : Binocular MTF/RSI tables + Diamond state panel, in one table
// =====================================================================

// ---------------------------------------------------------------- inputs
gSig = "Signals"
sens       = input.float(2.0, "Sensitivity", minval = 1, maxval = 20, group = gSig)
smartOnly  = input.bool(false, "Smart signals only (EMA200 trend + not sideways)", group = gSig)
showSig    = input.bool(true, "Show signals", group = gSig)
adxThr     = input.int(15, "Sideways ADX threshold", minval = 1, group = gSig)
colorBars  = input.bool(true, "Color bars by trend", group = gSig)

gRisk = "Risk levels"
showLvls   = input.bool(true, "Show entry / stop / targets", group = gRisk)
atrLen     = input.int(14, "ATR length", minval = 1, group = gRisk)
atrRisk    = input.float(1.0, "Stop distance (x ATR)", minval = 0.1, step = 0.1, group = gRisk)

gSD = "Daily SD levels"
showSD     = input.bool(true, "Show settlement and SD levels", group = gSD)
showSD1    = input.bool(true, "Show 1.0 SD", group = gSD)
hvLook     = input.int(21, "HV lookback (days)", minval = 2, group = gSD)
annualDays = input.int(252, "Trading days per year", minval = 1, group = gSD)

gOver = "Overlays"
showVWAP   = input.bool(true, "Daily VWAP", group = gOver)
showEMA200 = input.bool(true, "EMA 200", group = gOver)

gMore = "Extra modules (all off by default)"
showCPR      = input.bool(false, "CPR (daily central pivot range)", group = gMore)
showRev      = input.bool(false, "Reversal signals (MACD cross + RSI)", group = gMore)
showRevZones = input.bool(false, "Reversal support/resistance zones", group = gMore)
showPivSR    = input.bool(false, "Pivot support/resistance lines", group = gMore)
showZones    = input.bool(false, "Supply / demand zones", group = gMore)
zoneLen      = input.int(10, "Zone swing length", minval = 2, group = gMore)
zoneMax      = input.int(5, "Zones kept per side", minval = 1, maxval = 20, group = gMore)
zoneWidth    = input.float(0.5, "Zone height (x ATR50)", minval = 0.1, step = 0.1, group = gMore)
showUT       = input.bool(false, "UT Bot trailing stop", group = gMore)
utKey        = input.float(2.0, "UT key value", minval = 0.1, step = 0.1, group = gMore)
utAtrLen     = input.int(10, "UT ATR period", minval = 1, group = gMore)

gDash = "Dashboard"
showDash   = input.bool(true, "Show dashboard", group = gDash)
dashPos    = input.string("Bottom Right", "Position", ["Top Right", "Middle Right", "Bottom Right", "Top Left", "Middle Left", "Bottom Left"], group = gDash)
dashSize   = input.string("Small", "Size", ["Normal", "Small", "Tiny"], group = gDash)

// ---------------------------------------------------------------- signal engine (Diamond)
supertrend(_src, factor, atrLength) =>
    atrv = ta.atr(atrLength)
    upperBand = _src + factor * atrv
    lowerBand = _src - factor * atrv
    prevLowerBand = nz(lowerBand[1])
    prevUpperBand = nz(upperBand[1])
    lowerBand := lowerBand > prevLowerBand or close[1] < prevLowerBand ? lowerBand : prevLowerBand
    upperBand := upperBand < prevUpperBand or close[1] > prevUpperBand ? upperBand : prevUpperBand
    int direction = na
    float superTrend = na
    prevSuperTrend = superTrend[1]
    if na(atrv[1])
        direction := 1
    else if prevSuperTrend == prevUpperBand
        direction := close > upperBand ? -1 : 1
    else
        direction := close < lowerBand ? 1 : -1
    superTrend := direction == -1 ? lowerBand : upperBand
    [superTrend, direction]

[st, stDir] = supertrend(close, sens * 2, 11)
sma13  = ta.sma(close, 13)
ema200 = ta.ema(close, 200)
[_diP, _diM, adxVal] = ta.dmi(15, 15)
sideways = adxVal < adxThr

bull = ta.crossover(close, st) and close >= sma13
bear = ta.crossunder(close, st) and close <= sma13
smartBull = bull and close > ema200 and not sideways
smartBear = bear and close < ema200 and not sideways

buySig  = smartOnly ? smartBull : bull
sellSig = smartOnly ? smartBear : bear

// ---------------------------------------------------------------- trade levels
atrBand = ta.atr(atrLen) * atrRisk

var int   pos   = 0
var float entry = na
var float sl    = na
var float tp1   = na
var float tp2   = na
var float tp3   = na

stopHit = (pos == 1 and low <= sl) or (pos == -1 and high >= sl)

if buySig
    pos   := 1
    entry := close
    sl    := low - atrBand
    tp1   := entry + (entry - sl) * 1
    tp2   := entry + (entry - sl) * 2
    tp3   := entry + (entry - sl) * 3
else if sellSig
    pos   := -1
    entry := close
    sl    := high + atrBand
    tp1   := entry - (sl - entry) * 1
    tp2   := entry - (sl - entry) * 2
    tp3   := entry - (sl - entry) * 3
else if stopHit
    pos := 0

lvlOn = showLvls and pos != 0 and not stopHit
plot(lvlOn ? entry : na, "Entry", color.orange, 2, plot.style_linebr)
plot(lvlOn ? sl : na,    "Stop",  color.red, 2, plot.style_linebr)
plot(lvlOn ? tp1 : na,   "TP 1:1", color.green, 1, plot.style_linebr)
plot(lvlOn ? tp2 : na,   "TP 2:1", color.green, 1, plot.style_linebr)
plot(lvlOn ? tp3 : na,   "TP 3:1", color.green, 1, plot.style_linebr)

// ---------------------------------------------------------------- signal markers
cBlue = #0395fc
cRed  = #fd0205
plotshape(showSig and buySig and not smartBull,  "Buy",        shape.labelup,   location.belowbar, cBlue, text = "Buy",        textcolor = color.white, size = size.small)
plotshape(showSig and sellSig and not smartBear, "Sell",       shape.labeldown, location.abovebar, cRed,  text = "Sell",       textcolor = color.white, size = size.small)
plotshape(showSig and buySig and smartBull,      "Smart Buy",  shape.labelup,   location.belowbar, cBlue, text = "Smart Buy",  textcolor = color.white, size = size.small)
plotshape(showSig and sellSig and smartBear,     "Smart Sell", shape.labeldown, location.abovebar, cRed,  text = "Smart Sell", textcolor = color.white, size = size.small)
plotshape(showLvls and stopHit and not (buySig or sellSig), "Stop hit", shape.xcross, location.absolute, color.red, size = size.tiny)

barcolor(colorBars ? (sideways ? #4b148d : close > st ? cBlue : cRed) : na)

// ---------------------------------------------------------------- daily SD levels (Binocular)
settle = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)
hv     = request.security(syminfo.tickerid, "D", ta.stdev(math.log(close / close[1]), hvLook)[1] * math.sqrt(annualDays), barmerge.gaps_off, barmerge.lookahead_on)
sd     = settle * hv * math.sqrt(1.0 / annualDays)
newDay = timeframe.change("D")
sdOn   = showSD and not newDay

plot(sdOn ? settle : na,            "Settlement", #ec186d, 2, plot.style_linebr)
plot(sdOn ? settle + sd * 0.5 : na, "+0.5 SD", color.new(color.orange, 20), 1, plot.style_linebr)
plot(sdOn ? settle - sd * 0.5 : na, "-0.5 SD", color.new(color.orange, 20), 1, plot.style_linebr)
plot(sdOn ? settle + sd * 0.7 : na, "+0.7 SD", color.new(color.red, 20), 1, plot.style_linebr)
plot(sdOn ? settle - sd * 0.7 : na, "-0.7 SD", color.new(color.red, 20), 1, plot.style_linebr)
plot(sdOn and showSD1 ? settle + sd : na, "+1 SD", color.new(color.lime, 20), 2, plot.style_linebr)
plot(sdOn and showSD1 ? settle - sd : na, "-1 SD", color.new(color.lime, 20), 2, plot.style_linebr)

// ---------------------------------------------------------------- overlays
vwapD = ta.vwap(hlc3, timeframe.change("D"))
plot(showVWAP ? vwapD : na, "Daily VWAP", close > vwapD ? color.blue : color.fuchsia, 2)
plot(showEMA200 ? ema200 : na, "EMA 200", close > ema200 ? #AAFF00 : #EE4B2B, 2)

// ---------------------------------------------------------------- CPR (Deep CPR)
cprHigh  = request.security(syminfo.tickerid, "D", high[1],  barmerge.gaps_off, barmerge.lookahead_on)
cprLow   = request.security(syminfo.tickerid, "D", low[1],   barmerge.gaps_off, barmerge.lookahead_on)
cprClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)
cprPivot = (cprHigh + cprLow + cprClose) / 3
cprBC    = (cprHigh + cprLow) / 2
cprTC    = 2 * cprPivot - cprBC
cprOn    = showCPR and not newDay
plot(cprOn ? cprPivot : na, "CPR Pivot", color.new(color.gray, 0), 2, plot.style_linebr)
plot(cprOn ? cprBC : na,    "CPR Bottom", color.new(color.gray, 30), 1, plot.style_linebr)
plot(cprOn ? cprTC : na,    "CPR Top",    color.new(color.gray, 30), 1, plot.style_linebr)

// ---------------------------------------------------------------- reversal signals + zones (Reversal Algo)
[macdLine, macdSignal, macdHist] = ta.macd(close, 20, 50, 12)
macdUp = ta.crossover(macdLine, macdSignal)
macdDn = ta.crossunder(macdLine, macdSignal)
rsiBias = ta.rsi(close, 14) - 50

plotshape(showRev and macdUp and rsiBias > 0,  "Strong Reversal Buy",  shape.triangleup,   location.belowbar, color.lime, text = "R+", textcolor = color.white, size = size.tiny)
plotshape(showRev and macdUp and rsiBias <= 0, "Reversal Buy",         shape.triangleup,   location.belowbar, color.new(color.lime, 40), text = "R", textcolor = color.white, size = size.tiny)
plotshape(showRev and macdDn and rsiBias < 0,  "Strong Reversal Sell", shape.triangledown, location.abovebar, color.red, text = "R+", textcolor = color.white, size = size.tiny)
plotshape(showRev and macdDn and rsiBias >= 0, "Reversal Sell",        shape.triangledown, location.abovebar, color.new(color.red, 40), text = "R", textcolor = color.white, size = size.tiny)

kalman(inp, q, r) =>
    var float kx = 0.0
    var float kp = 1.0
    if not na(inp)
        kk = kp / (kp + r)
        kx := kk * inp + (1 - kk) * kx
        kp := (1 - kk) * kp + q
    kx

zAtr   = ta.atr(10)
zUpper = hl2 + zAtr * 5
zLower = hl2 - zAtr * 5
zSup   = ta.lowest(low, 20)
zRes   = ta.highest(high, 20)
supA = kalman(math.max(zSup, ta.lowest(zLower, 20)), 0.01, 0.1)
supB = kalman(math.min(zSup, ta.highest(zLower, 20)), 0.01, 0.1)
resA = kalman(math.max(zRes, ta.lowest(zUpper, 20)), 0.01, 0.1)
resB = kalman(math.min(zRes, ta.highest(zUpper, 20)), 0.01, 0.1)

pSupA = plot(showRevZones ? supA : na, "Support A", color.new(color.blue, 70))
pSupB = plot(showRevZones ? supB : na, "Support B", color.new(color.blue, 70))
pResA = plot(showRevZones ? resA : na, "Resistance A", color.new(color.red, 70))
pResB = plot(showRevZones ? resB : na, "Resistance B", color.new(color.red, 70))
fill(pSupA, pSupB, color.new(color.blue, 85))
fill(pResA, pResB, color.new(color.red, 85))

// ---------------------------------------------------------------- pivot support / resistance (Ultra Algo)
pivRes = fixnan(ta.pivothigh(15, 15)[1])
pivSup = fixnan(ta.pivotlow(15, 15)[1])
plot(showPivSR ? pivRes : na, "Pivot Resistance", ta.change(pivRes) ? na : #FF0000, 2, offset = -16)
plot(showPivSR ? pivSup : na, "Pivot Support",    ta.change(pivSup) ? na : #00ff0d, 2, offset = -16)

// ---------------------------------------------------------------- supply / demand zones (cleaned)
atr50 = ta.atr(50)
swHigh = ta.pivothigh(high, zoneLen, zoneLen)
swLow  = ta.pivotlow(low, zoneLen, zoneLen)

var box[] supplyBoxes = array.new_box()
var box[] demandBoxes = array.new_box()

if showZones and not na(swHigh)
    array.push(supplyBoxes, box.new(bar_index - zoneLen, swHigh, bar_index, swHigh - atr50 * zoneWidth, border_color = color.new(color.red, 60), bgcolor = color.new(color.red, 85), extend = extend.right, text = "SUPPLY", text_color = color.gray, text_size = size.tiny))
    if array.size(supplyBoxes) > zoneMax
        box.delete(array.shift(supplyBoxes))

if showZones and not na(swLow)
    array.push(demandBoxes, box.new(bar_index - zoneLen, swLow + atr50 * zoneWidth, bar_index, swLow, border_color = color.new(color.teal, 60), bgcolor = color.new(color.teal, 85), extend = extend.right, text = "DEMAND", text_color = color.gray, text_size = size.tiny))
    if array.size(demandBoxes) > zoneMax
        box.delete(array.shift(demandBoxes))

// remove a zone once price closes through it
if array.size(supplyBoxes) > 0
    for i = array.size(supplyBoxes) - 1 to 0
        if close > box.get_top(array.get(supplyBoxes, i))
            box.delete(array.get(supplyBoxes, i))
            array.remove(supplyBoxes, i)
if array.size(demandBoxes) > 0
    for i = array.size(demandBoxes) - 1 to 0
        if close < box.get_bottom(array.get(demandBoxes, i))
            box.delete(array.get(demandBoxes, i))
            array.remove(demandBoxes, i)

// ---------------------------------------------------------------- UT Bot trailing stop
utLoss = utKey * ta.atr(utAtrLen)
utStop = 0.0
utIff1 = close > nz(utStop[1], 0) ? close - utLoss : close + utLoss
utIff2 = close < nz(utStop[1], 0) and close[1] < nz(utStop[1], 0) ? math.min(nz(utStop[1]), close + utLoss) : utIff1
utStop := close > nz(utStop[1], 0) and close[1] > nz(utStop[1], 0) ? math.max(nz(utStop[1]), close - utLoss) : utIff2
plot(showUT ? utStop : na, "UT Bot Stop", close > utStop ? color.green : color.red, 1)

// ---------------------------------------------------------------- dashboard data
f_tf(tf) =>
    request.security(syminfo.tickerid, tf, [close > ta.ema(close, 200), ta.rsi(close, 14)])

[b1, r1]   = f_tf("1")
[b5, r5]   = f_tf("5")
[b15, r15] = f_tf("15")
[b30, r30] = f_tf("30")
[b60, r60] = f_tf("60")
[b240, r240] = f_tf("240")
[bD, rD]   = f_tf("D")

atr3 = 3 * ta.atr(10)
devSd = 2 * ta.stdev(atr3, 20)
devMa = ta.sma(atr3, 20)
calcDev = (atr3 - (devMa - devSd)) / math.max((devMa + devSd) - (devMa - devSd), 1e-10)
volPct = 40 * calcDev + 30

ema9 = ta.ema(close, 9)
sentiment = ema9 > ema9[2] ? "Bullish" : ema9 < ema9[2] ? "Bearish" : "Flat"
marketState = adxVal < 15 ? "No trend" : adxVal < 25 ? "Ranging" : "Trending"

inSess(s) => not na(time(timeframe.period, s, "UTC"))
sNY = inSess("1300-2200")
sLD = inSess("0700-1600")
sTK = inSess("0000-0900")
sSY = inSess("2100-0600")
sessTxt = (sNY ? "NY " : "") + (sLD ? "London " : "") + (sTK ? "Tokyo " : "") + (sSY ? "Sydney" : "")
sessTxt := sessTxt == "" ? "Off hours" : sessTxt

posTxt = pos == 1 ? "Long" : pos == -1 ? "Short" : "Flat"

tblPos = dashPos == "Top Right" ? position.top_right : dashPos == "Middle Right" ? position.middle_right : dashPos == "Bottom Right" ? position.bottom_right : dashPos == "Top Left" ? position.top_left : dashPos == "Middle Left" ? position.middle_left : position.bottom_left
tblSize = dashSize == "Normal" ? size.normal : dashSize == "Small" ? size.small : size.tiny

var table dash = table.new(tblPos, 5, 8, color.rgb(30, 34, 45, 40), color.gray, 1, color.gray, 1)

f_tfRow(row, name, bullish, rsiVal) =>
    rsiBg = rsiVal >= 50 ? color.new(color.green, 40) : color.new(color.red, 40)
    table.cell(dash, 0, row, name, text_color = color.white, text_size = tblSize)
    table.cell(dash, 1, row, bullish ? "Bull" : "Bear", text_color = color.white, bgcolor = bullish ? cBlue : cRed, text_size = tblSize)
    table.cell(dash, 2, row, str.tostring(rsiVal, "#.#"), text_color = color.white, bgcolor = rsiBg, text_size = tblSize)

f_infoRow(row, label, value) =>
    table.cell(dash, 3, row, label, text_color = color.silver, text_halign = text.align_left, text_size = tblSize)
    table.cell(dash, 4, row, value, text_color = color.white, text_halign = text.align_left, text_size = tblSize)

if barstate.islast and showDash
    table.cell(dash, 0, 0, "TF", text_color = color.yellow, text_size = tblSize)
    table.cell(dash, 1, 0, "EMA200", text_color = color.yellow, text_size = tblSize)
    table.cell(dash, 2, 0, "RSI14", text_color = color.yellow, text_size = tblSize)
    table.cell(dash, 3, 0, "Merged Algo", text_color = color.yellow, text_halign = text.align_left, text_size = tblSize)
    table.cell(dash, 4, 0, "", text_size = tblSize)
    f_tfRow(1, "1m", b1, r1)
    f_tfRow(2, "5m", b5, r5)
    f_tfRow(3, "15m", b15, r15)
    f_tfRow(4, "30m", b30, r30)
    f_tfRow(5, "1H", b60, r60)
    f_tfRow(6, "4H", b240, r240)
    f_tfRow(7, "1D", bD, rD)
    f_infoRow(1, "Position", posTxt)
    f_infoRow(2, "Sensitivity", str.tostring(sens))
    f_infoRow(3, "Market", marketState + " (ADX " + str.tostring(adxVal, "#.#") + ")")
    f_infoRow(4, "Volatility", str.tostring(volPct, "#.#") + "%")
    f_infoRow(5, "Session (UTC)", sessTxt)
    f_infoRow(6, "Momentum", sentiment)
    f_infoRow(7, "Daily SD", str.tostring(sd, format.mintick))

// ---------------------------------------------------------------- alerts
alertcondition(buySig,  "Buy Signal",  "BUY {{ticker}} @ {{close}}")
alertcondition(sellSig, "Sell Signal", "SELL {{ticker}} @ {{close}}")
alertcondition(stopHit and not (buySig or sellSig), "Stop Hit", "STOP HIT {{ticker}} @ {{close}}")
alertcondition(macdUp and rsiBias > 0, "Strong Reversal Buy",  "REVERSAL BUY {{ticker}} @ {{close}}")
alertcondition(macdDn and rsiBias < 0, "Strong Reversal Sell", "REVERSAL SELL {{ticker}} @ {{close}}")
